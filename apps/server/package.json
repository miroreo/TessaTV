    "@tessatv/domain": "workspace:*",
    "@tessatv/jellyfin-compat": "workspace:*",
    "@tessatv/jobs": "workspace:*",
    "@tessatv/library": "workspace:*",
    "@tessatv/metadata": "workspace:*",
    "@tessatv/persistence": "workspace:*",
    "@tessatv/streaming": "workspace:*",
    "@tessatv/web": "workspace:*",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
