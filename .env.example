DATABASE_URL=postgres://tessatv:tessatv@localhost:5432/tessatv
PORT=8096
# Used to derive the encryption key for indexer/download-client credentials at rest.
# Generate with: openssl rand -base64 32
APP_SECRET=
# Optional: movie metadata identification/artwork features are disabled until this is set.
# Get one free at https://www.themoviedb.org/settings/api (requires an account).
TMDB_API_KEY=
# Optional: TV metadata identification/artwork features are disabled until this is set.
# Get one at https://thetvdb.com (check their current API terms/pricing).
TVDB_API_KEY=

# Optional: subtitle downloads are off until all three are set. Your own OpenSubtitles.com account:
# the API key is made under the account's "API consumers" page; downloads also need the login.
# Subtitles are written beside each video, so the media folders must be writable.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# Comma-separated, most wanted first; `.forced` adds a language's forced track: en,pt-BR,en.forced
SUBTITLE_LANGUAGES=en
# prefer | avoid | any: subtitles for the deaf and hard of hearing (SDH)
SUBTITLE_HEARING_IMPAIRED=avoid

# Transcoding. auto = VAAPI when it works, otherwise software; none | vaapi to force one.
HARDWARE_ACCEL=auto
# VAAPI_DEVICE=/dev/dri/renderD128
# VAAPI_HARDWARE_DECODE=false  # true decodes on the GPU too; corrupt files can hang some GPUs
# TRANSCODE_DIR=/tmp/tessatv-transcodes
# MAX_CONCURRENT_TRANSCODES=3
# Memory diagnostics, for chasing a leak: logs heap numbers and writes a heap profile and
# snapshot to this directory when the heap first reaches the size below (MB).
# DIAGNOSTICS_DIR=/tmp/tessatv-diagnostics
# DIAGNOSTICS_CAPTURE_AT_MB=1024
